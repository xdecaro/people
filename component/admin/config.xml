<?xml version="1.0" encoding="utf-8"?>
<config>
  <fieldset name="notifications" label="COM_XDECAROPEOPLE_CONFIG_NOTIFICATIONS">
    <field
      name="notification_recipient_user_id"
      type="user"
      label="COM_XDECAROPEOPLE_CONFIG_NOTIFICATION_RECIPIENT"
      description="COM_XDECAROPEOPLE_CONFIG_NOTIFICATION_RECIPIENT_DESC"
      default="0"
    />
    <field
      name="notification_event_types"
      type="checkboxes"
      label="COM_XDECAROPEOPLE_CONFIG_NOTIFICATION_TYPES"
      description="COM_XDECAROPEOPLE_CONFIG_NOTIFICATION_TYPES_DESC"
      default="created,possible_duplicate"
      filter="array"
    >
      <option value="created">COM_XDECAROPEOPLE_CONFIG_NOTIFICATION_TYPE_CREATED</option>
      <option value="updated">COM_XDECAROPEOPLE_CONFIG_NOTIFICATION_TYPE_UPDATED</option>
      <option value="state">COM_XDECAROPEOPLE_CONFIG_NOTIFICATION_TYPE_STATE</option>
      <option value="possible_duplicate">COM_XDECAROPEOPLE_CONFIG_NOTIFICATION_TYPE_DUPLICATE</option>
    </field>
  </fieldset>
  <fieldset name="maintenance" label="COM_XDECAROPEOPLE_CONFIG_MAINTENANCE">
    <field
      name="backup_storage_path"
      type="text"
      label="COM_XDECAROPEOPLE_CONFIG_BACKUP_STORAGE_PATH"
      description="COM_XDECAROPEOPLE_CONFIG_BACKUP_STORAGE_PATH_DESC"
      default=""
      filter="string"
    />
    <field
      name="backup_max_upload_mb"
      type="number"
      label="COM_XDECAROPEOPLE_CONFIG_BACKUP_MAX_UPLOAD_MB"
      description="COM_XDECAROPEOPLE_CONFIG_BACKUP_MAX_UPLOAD_MB_DESC"
      default="64"
      min="1"
      step="1"
      filter="uint"
    />
  </fieldset>
  <fieldset name="list_view" label="COM_XDECAROPEOPLE_CONFIG_LIST_VIEW">
    <field
      name="list_visible_columns"
      type="checkboxes"
      label="COM_XDECAROPEOPLE_CONFIG_LIST_VISIBLE_COLUMNS"
      description="COM_XDECAROPEOPLE_CONFIG_LIST_VISIBLE_COLUMNS_DESC"
      default="display_name,birth_date,birth_place,email,phone,person_status,state"
      filter="array"
    >
      <option value="display_name">COM_XDECAROPEOPLE_FIELD_DISPLAY_NAME</option>
      <option value="birth_date">COM_XDECAROPEOPLE_FIELD_BIRTH_DATE</option>
      <option value="birth_place">COM_XDECAROPEOPLE_FIELD_BIRTH_PLACE</option>
      <option value="email">JGLOBAL_EMAIL</option>
      <option value="phone">COM_XDECAROPEOPLE_FIELD_PHONE</option>
      <option value="person_status">COM_XDECAROPEOPLE_FIELD_PERSON_STATUS</option>
      <option value="state">JSTATUS</option>
    </field>
  </fieldset>
  <fieldset name="permissions" label="JCONFIG_PERMISSIONS_LABEL" description="JCONFIG_PERMISSIONS_DESC">
    <field name="rules" type="rules" label="JCONFIG_PERMISSIONS_LABEL" filter="rules" validate="rules" component="com_xdecaropeople" section="component"/>
  </fieldset>
</config>
