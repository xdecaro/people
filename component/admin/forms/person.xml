<?xml version="1.0" encoding="utf-8"?>
<form addfieldprefix="xdecaro\Component\People\Administrator\Field">
  <fieldset name="identity" label="COM_XDECAROPEOPLE_FIELDSET_IDENTITY">
    <field name="id" type="hidden"/>
    <field name="uuid" type="text" label="COM_XDECAROPEOPLE_FIELD_UUID" readonly="true" filter="cmd"/>
    <field name="first_name" type="text" label="COM_XDECAROPEOPLE_FIELD_FIRST_NAME" required="true" filter="string" maxlength="150"/>
    <field name="last_name" type="text" label="COM_XDECAROPEOPLE_FIELD_LAST_NAME" required="true" filter="string" maxlength="150"/>
    <field name="birth_date" type="calendar" label="COM_XDECAROPEOPLE_FIELD_BIRTH_DATE" format="%d/%m/%Y" filter="raw" filterformat="d/m/Y" todaybutton="true" filltable="true"/>
    <field name="sex" type="list" label="COM_XDECAROPEOPLE_FIELD_SEX" filter="cmd">
      <option value="">COM_XDECAROPEOPLE_SELECT_OPTION</option>
      <option value="M">COM_XDECAROPEOPLE_SEX_MALE</option>
      <option value="F">COM_XDECAROPEOPLE_SEX_FEMALE</option>
    </field>
    <field name="birth_country_code" type="Country" code="alpha2" label="COM_XDECAROPEOPLE_FIELD_BIRTH_COUNTRY" filter="cmd" validate="options" layout="joomla.form.field.list-fancy-select">
      <option value="">COM_XDECAROPEOPLE_SELECT_BIRTH_COUNTRY</option>
    </field>
    <field name="birth_place" type="text" label="COM_XDECAROPEOPLE_FIELD_BIRTH_PLACE" description="COM_XDECAROPEOPLE_FIELD_BIRTH_PLACE_DESC" filter="string" maxlength="190" autocomplete="off"/>
    <field name="birth_place_id" type="hidden" filter="string"/>
    <field name="birth_region" type="hidden" filter="string"/>
    <field name="tax_identifier" type="text" label="COM_XDECAROPEOPLE_FIELD_TIN" filter="string" maxlength="64"/>
    <field name="nationality_codes" type="Country" code="alpha3" label="COM_XDECAROPEOPLE_FIELD_NATIONALITIES" multiple="true" filter="array" layout="joomla.form.field.list-fancy-select">
      <option value="">COM_XDECAROPEOPLE_SELECT_NATIONALITY</option>
    </field>
    <field name="nationality_code" type="hidden" filter="cmd"/>
  </fieldset>

  <fieldset name="contacts" label="COM_XDECAROPEOPLE_FIELDSET_CONTACTS">
    <field name="email" type="email" label="JGLOBAL_EMAIL" filter="string" maxlength="254"/>
    <field name="phone" type="tel" label="COM_XDECAROPEOPLE_FIELD_PHONE" filter="string" maxlength="50"/>
    <field name="whatsapp" type="tel" label="COM_XDECAROPEOPLE_FIELD_WHATSAPP" filter="string" maxlength="50"/>
    <field name="preferred_contact" type="list" label="COM_XDECAROPEOPLE_FIELD_PREFERRED_CONTACT" filter="cmd">
      <option value="">COM_XDECAROPEOPLE_SELECT_OPTION</option>
      <option value="email">JGLOBAL_EMAIL</option>
      <option value="phone">COM_XDECAROPEOPLE_FIELD_PHONE</option>
      <option value="whatsapp">COM_XDECAROPEOPLE_FIELD_WHATSAPP</option>
      <option value="other">COM_XDECAROPEOPLE_CONTACT_OTHER</option>
    </field>
    <field name="language" type="contentlanguage" label="COM_XDECAROPEOPLE_FIELD_COMMUNICATION_LANGUAGE"/>
  </fieldset>

  <fieldset name="disability" label="COM_XDECAROPEOPLE_FIELDSET_DISABILITY">
    <field name="disability_status" type="list" label="COM_XDECAROPEOPLE_FIELD_DISABILITY" filter="string">
      <option value="">COM_XDECAROPEOPLE_SELECT_OPTION</option>
      <option value="1">JYES</option>
      <option value="0">JNO</option>
    </field>
    <field name="disability_types" type="list" label="COM_XDECAROPEOPLE_FIELD_DISABILITY_TYPES" multiple="true" filter="array" layout="joomla.form.field.list-fancy-select" showon="disability_status:1">
      <option value="hearing">COM_XDECAROPEOPLE_DISABILITY_HEARING</option>
      <option value="visual">COM_XDECAROPEOPLE_DISABILITY_VISUAL</option>
      <option value="motor">COM_XDECAROPEOPLE_DISABILITY_MOTOR</option>
      <option value="intellectual_cognitive">COM_XDECAROPEOPLE_DISABILITY_INTELLECTUAL_COGNITIVE</option>
      <option value="psychosocial">COM_XDECAROPEOPLE_DISABILITY_PSYCHOSOCIAL</option>
      <option value="multiple">COM_XDECAROPEOPLE_DISABILITY_MULTIPLE</option>
      <option value="other">COM_XDECAROPEOPLE_DISABILITY_OTHER</option>
    </field>
    <field name="disability_other" type="text" label="COM_XDECAROPEOPLE_FIELD_DISABILITY_OTHER" filter="string" maxlength="190" size="30" showon="disability_status:1[AND]disability_types:other"/>
  </fieldset>

  <fieldset name="accessibility" label="COM_XDECAROPEOPLE_FIELDSET_ACCESSIBILITY">
    <field name="accessibility_needs" type="list" label="COM_XDECAROPEOPLE_FIELD_ACCESSIBILITY_NEEDS" multiple="true" filter="array" layout="joomla.form.field.list-fancy-select">
      <option value="sign_language_interpreter">COM_XDECAROPEOPLE_ACCESSIBILITY_SIGN_LANGUAGE_INTERPRETER</option>
      <option value="captions">COM_XDECAROPEOPLE_ACCESSIBILITY_CAPTIONS</option>
      <option value="wheelchair_access">COM_XDECAROPEOPLE_ACCESSIBILITY_WHEELCHAIR</option>
      <option value="companion">COM_XDECAROPEOPLE_ACCESSIBILITY_COMPANION</option>
      <option value="written_communication">COM_XDECAROPEOPLE_ACCESSIBILITY_WRITTEN</option>
      <option value="other">COM_XDECAROPEOPLE_ACCESSIBILITY_OTHER</option>
    </field>
    <field name="accessibility_other" type="text" label="COM_XDECAROPEOPLE_FIELD_ACCESSIBILITY_OTHER" filter="string" maxlength="190" size="30" showon="accessibility_needs:other"/>
  </fieldset>

  <fieldset name="residence" label="COM_XDECAROPEOPLE_FIELDSET_RESIDENCE">
    <field name="address_line" type="text" label="COM_XDECAROPEOPLE_FIELD_ADDRESS" filter="string" maxlength="255"/>
    <field name="address_number" type="text" label="COM_XDECAROPEOPLE_FIELD_ADDRESS_NUMBER" filter="string" maxlength="32"/>
    <field name="postal_code" type="text" label="COM_XDECAROPEOPLE_FIELD_POSTAL_CODE" filter="string" maxlength="32"/>
    <field name="country_code" type="Country" code="alpha2" label="COM_XDECAROPEOPLE_FIELD_COUNTRY" filter="cmd" validate="options" layout="joomla.form.field.list-fancy-select">
      <option value="">COM_XDECAROPEOPLE_SELECT_COUNTRY</option>
    </field>
    <field name="city" type="text" label="COM_XDECAROPEOPLE_FIELD_CITY" description="COM_XDECAROPEOPLE_FIELD_CITY_DESC" filter="string" maxlength="190" autocomplete="off"/>
    <field name="residence_place_id" type="hidden" filter="string"/>
    <field name="region" type="text" label="COM_XDECAROPEOPLE_FIELD_REGION" filter="string" maxlength="190"/>
    <field name="additional_addresses" type="subform" label="COM_XDECAROPEOPLE_FIELD_ADDITIONAL_ADDRESSES" formsource="administrator/components/com_xdecaropeople/forms/additional_address.xml" multiple="true" layout="joomla.form.field.subform.repeatable-table"/>
  </fieldset>

  <fieldset name="relations" label="COM_XDECAROPEOPLE_FIELDSET_RELATIONS">
    <field name="relations_data" type="subform" label="COM_XDECAROPEOPLE_FIELD_RELATIONS" formsource="administrator/components/com_xdecaropeople/forms/person_relation.xml" multiple="true" layout="joomla.form.field.subform.repeatable-table"/>
  </fieldset>

  <fieldset name="social" label="COM_XDECAROPEOPLE_FIELDSET_SOCIAL">
    <field name="social_instagram" type="url" label="COM_XDECAROPEOPLE_FIELD_INSTAGRAM" filter="url" maxlength="255"/>
    <field name="social_facebook" type="url" label="COM_XDECAROPEOPLE_FIELD_FACEBOOK" filter="url" maxlength="255"/>
    <field name="social_linkedin" type="url" label="COM_XDECAROPEOPLE_FIELD_LINKEDIN" filter="url" maxlength="255"/>
    <field name="social_tiktok" type="url" label="COM_XDECAROPEOPLE_FIELD_TIKTOK" filter="url" maxlength="255"/>
    <field name="social_telegram" type="url" label="COM_XDECAROPEOPLE_FIELD_TELEGRAM" filter="url" maxlength="255"/>
    <field name="social_x" type="url" label="COM_XDECAROPEOPLE_FIELD_X" filter="url" maxlength="255"/>
    <field name="social_youtube" type="url" label="COM_XDECAROPEOPLE_FIELD_YOUTUBE" filter="url" maxlength="255"/>
    <field name="website_url" type="url" label="COM_XDECAROPEOPLE_FIELD_WEBSITE" filter="url" maxlength="255"/>
  </fieldset>

  <fieldset name="publishing" label="JGLOBAL_FIELDSET_PUBLISHING">
    <field name="person_status" type="list" label="COM_XDECAROPEOPLE_FIELD_PERSON_STATUS" default="active" filter="cmd">
      <option value="active">COM_XDECAROPEOPLE_PERSON_STATUS_ACTIVE</option>
      <option value="archived">COM_XDECAROPEOPLE_PERSON_STATUS_ARCHIVED</option>
      <option value="deceased">COM_XDECAROPEOPLE_PERSON_STATUS_DECEASED</option>
    </field>
    <field name="state" type="list" label="JSTATUS" default="1">
      <option value="1">JPUBLISHED</option>
      <option value="0">JUNPUBLISHED</option>
      <option value="-2">JTRASHED</option>
    </field>
    <field name="access" type="accesslevel" label="JFIELD_ACCESS_LABEL"/>
    <field name="notes" type="textarea" label="COM_XDECAROPEOPLE_FIELD_NOTES" rows="5" filter="safehtml"/>
  </fieldset>

  <fieldset name="system" label="COM_XDECAROPEOPLE_FIELDSET_SYSTEM">
    <field name="user_id" type="user" label="COM_XDECAROPEOPLE_FIELD_USER"/>
    <field name="profile_document_uuid" type="text" label="COM_XDECAROPEOPLE_FIELD_PROFILE_DOCUMENT" description="COM_XDECAROPEOPLE_FIELD_PROFILE_DOCUMENT_DESC" filter="cmd" maxlength="36"/>
    <field name="source_component" type="text" label="COM_XDECAROPEOPLE_FIELD_SOURCE_COMPONENT" readonly="true" filter="cmd"/>
    <field name="created" type="calendar" label="JGLOBAL_FIELD_CREATED_LABEL" readonly="true" format="%d/%m/%Y %H:%M" filter="user_utc" showtime="true"/>
    <field name="modified" type="calendar" label="JGLOBAL_FIELD_MODIFIED_LABEL" readonly="true" format="%d/%m/%Y %H:%M" filter="user_utc" showtime="true"/>
  </fieldset>
</form>
